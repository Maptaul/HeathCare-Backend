model Payment {
  id String @id @default(uuid())

  status PaymentStatus @default(UNPAID)

  amount   Decimal @db.Decimal(10, 2) //100.20
  currency String  @default("BDT") //BDT, USD, EUR, GBP, CAD, AUD, JPY, CNY

  paymentGateway        PaymentGateway @default(BKASH)
  merchantInvoiceNumber String         @unique //appointmentId + userId + timestamp

  bkashPaymentId String? @unique
  bkashTrxId     String? @unique
  payerReference String? @unique //user email or phone number
  paidAt         String?

  gatewayResponse Json?

  refundTrxId  String?
  refundAmount Decimal? @db.Decimal(10, 2) //100.20
  refundReason String?
  refundedAt   String?

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}
