// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  // Vercel's Node.js runtime runs the compiled output directly under native
  // Node ESM (no bundler), which requires explicit extensions on relative
  // imports. Without this, generator defaults to no extension based on this
  // project's tsconfig `moduleResolution: "bundler"` (correct for local
  // tsup/tsx, but unresolvable at Vercel runtime).
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
