<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Prescription</title>
    <style>
      :root {
        --primary: #1f4e79;
        --primary-dark: #163a5c;
        --secondary: #e8f0f7;
        --accent: #f5a623;
        --text: #1f2937;
        --muted: #6b7280;
        --border: #dfe7ee;
        --success: #1e8e5a;
        --white: #ffffff;
        --shadow: rgba(31, 41, 55, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(135deg, #eef3f8 0%, #f6f9fb 100%);
        color: var(--text);
      }

      .page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 20px;
      }

      .container {
        width: 100%;
        max-width: 760px;
      }

      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--primary);
        padding: 22px 28px;
        border-radius: 18px 18px 0 0;
        color: var(--white);
      }

      .brand {
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: 0.04em;
      }

      .status {
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-top: none;
        border-radius: 0 0 18px 18px;
        box-shadow: 0 18px 40px var(--shadow);
        padding: 34px 32px 28px;
      }

      .badge {
        display: inline-block;
        background: var(--secondary);
        color: var(--primary-dark);
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 20px 0 12px;
        font-size: clamp(2rem, 4vw, 2.6rem);
        line-height: 1.2;
      }

      .subtitle {
        margin: 0 0 26px;
        color: var(--muted);
        font-size: 1.02rem;
        line-height: 1.7;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(180px, 1fr));
        gap: 18px;
        margin: 28px 0;
      }

      .info-item {
        background: #f7fafc;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px 18px 16px;
      }

      .info-item.full-width {
        grid-column: 1 / -1;
      }

      .label {
        display: block;
        color: var(--muted);
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 8px;
      }

      .value {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text);
      }

      .section-title {
        margin: 32px 0 12px;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--primary-dark);
      }

      .findings {
        background: #f7fafc;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px 20px;
        line-height: 1.7;
        color: var(--text);
      }

      .rx-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 4px;
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
      }

      .rx-table th {
        background: var(--primary);
        color: var(--white);
        text-align: left;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 12px 14px;
      }

      .rx-table td {
        padding: 12px 14px;
        border-top: 1px solid var(--border);
        font-size: 0.96rem;
        vertical-align: top;
      }

      .rx-table tr:nth-child(even) td {
        background: #f7fafc;
      }

      .note {
        background: linear-gradient(135deg, #edf9f4 0%, #f4fbf8 100%);
        border: 1px solid #cfead9;
        border-left: 6px solid var(--success);
        border-radius: 12px;
        padding: 16px 18px;
        margin: 28px 0 30px;
        color: #1f4632;
        font-size: 0.98rem;
        line-height: 1.6;
      }

      .footer {
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
        margin-top: 18px;
      }

      @media (max-width: 640px) {
        .header {
          flex-direction: column;
          gap: 12px;
          text-align: center;
        }

        .info-grid {
          grid-template-columns: 1fr;
        }

        .card {
          padding: 24px 20px 22px;
        }

        .rx-table {
          font-size: 0.85rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="container">
        <div class="header">
          <div class="brand"><%= locals.clinicName || "CareConnect" %></div>
          <div class="status">Prescription</div>
        </div>

        <div class="card">
          <div class="badge">Prescription Ready</div>
          <h1>Your prescription is ready</h1>
          <p class="subtitle">
            Dr. <%= doctorName %> has issued a new prescription for you. A
            copy is attached to this email as a PDF for your records and for
            the pharmacy.
          </p>

          <div class="info-grid">
            <div class="info-item">
              <span class="label">Patient</span>
              <div class="value"><%= patientName %></div>
            </div>
            <div class="info-item">
              <span class="label">Patient Email</span>
              <div class="value"><%= patientEmail %></div>
            </div>
            <div class="info-item">
              <span class="label">Doctor</span>
              <div class="value">Dr. <%= doctorName %></div>
            </div>
            <div class="info-item">
              <span class="label">Specialization</span>
              <div class="value"><%= doctorSpecialization %></div>
            </div>
            <div class="info-item">
              <span class="label">License No.</span>
              <div class="value"><%= doctorLicenseNumber %></div>
            </div>
            <div class="info-item">
              <span class="label">Issued On</span>
              <div class="value"><%= locals.issuedDate || new Date().toDateString() %></div>
            </div>
          </div>

          <div class="section-title">Clinical Findings / Diagnosis</div>
          <div class="findings"><%= findings %></div>

          <div class="section-title">Prescribed Medicines (Rx)</div>
          <table class="rx-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Medicine</th>
                <th>Dosage</th>
                <th>Duration</th>
                <th>Instructions</th>
              </tr>
            </thead>
            <tbody>
              <% (locals.medicines || []).forEach(function (medicine, index) { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= medicine.name %></td>
                <td><%= medicine.dosage %></td>
                <td><%= medicine.duration %></td>
                <td><%= medicine.instructions || "-" %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>

          <div class="note">
            Please follow the dosage and duration exactly as prescribed. If
            you experience any adverse reaction, stop the medicine and
            contact Dr. <%= doctorName %> or your nearest emergency service
            immediately.
          </div>
        </div>

        <div class="footer">
          This is a digitally generated prescription and is valid without a
          physical signature. Your full prescription is attached as a PDF.
        </div>
      </div>
    </div>
  </body>
</html>
