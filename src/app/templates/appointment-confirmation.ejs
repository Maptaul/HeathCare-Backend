<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Appointment Confirmation</title>
    <style>
      :root {
        --primary: #1e7f7a;
        --primary-dark: #135f5c;
        --secondary: #e8f6f5;
        --accent: #f5a623;
        --text: #1f2937;
        --muted: #6b7280;
        --border: #dfe7e7;
        --success: #1e8e5a;
        --white: #ffffff;
        --shadow: rgba(31, 41, 55, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(135deg, #eef8f8 0%, #f5fbfb 100%);
        color: var(--text);
      }

      .page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 20px;
      }

      .container {
        width: 100%;
        max-width: 760px;
      }

      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--primary);
        padding: 22px 28px;
        border-radius: 18px 18px 0 0;
        color: var(--white);
      }

      .brand {
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: 0.04em;
      }

      .status {
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-top: none;
        border-radius: 0 0 18px 18px;
        box-shadow: 0 18px 40px var(--shadow);
        padding: 34px 32px 28px;
      }

      .badge {
        display: inline-block;
        background: var(--secondary);
        color: var(--primary-dark);
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 20px 0 12px;
        font-size: clamp(2rem, 4vw, 2.6rem);
        line-height: 1.2;
      }

      .subtitle {
        margin: 0 0 26px;
        color: var(--muted);
        font-size: 1.02rem;
        line-height: 1.7;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(180px, 1fr));
        gap: 18px;
        margin: 28px 0;
      }

      .info-item {
        background: #f8fbfb;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px 18px 16px;
      }

      .info-item.full-width {
        grid-column: 1 / -1;
      }

      .label {
        display: block;
        color: var(--muted);
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 8px;
      }

      .value {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text);
      }

      .note {
        background: linear-gradient(135deg, #edf9f4 0%, #f4fbf8 100%);
        border: 1px solid #cfead9;
        border-left: 6px solid var(--success);
        border-radius: 12px;
        padding: 16px 18px;
        margin: 28px 0 30px;
        color: #1f4632;
        font-size: 0.98rem;
        line-height: 1.6;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }

      .btn {
        display: inline-block;
        text-decoration: none;
        border-radius: 10px;
        padding: 14px 22px;
        font-weight: 700;
        transition: 0.2s ease;
      }

      .btn-primary {
        background: var(--primary);
        color: var(--white);
      }

      .btn-primary:hover {
        background: var(--primary-dark);
      }

      .btn-secondary {
        background: var(--white);
        color: var(--primary-dark);
        border: 1px solid var(--border);
      }

      .footer {
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
        margin-top: 18px;
      }

      @media (max-width: 640px) {
        .header {
          flex-direction: column;
          gap: 12px;
          text-align: center;
        }

        .info-grid {
          grid-template-columns: 1fr;
        }

        .card {
          padding: 24px 20px 22px;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="container">
        <div class="header">
          <div class="brand"><%= clinicName || "CareConnect" %></div>
          <div class="status"><%= status || "Confirmed" %></div>
        </div>

        <div class="card">
          <div class="badge">
            Appointment <%= (status || "Confirmed").toLowerCase() %>
          </div>
          <h1>
            Your appointment is <%= (status || "confirmed").toLowerCase() %>
          </h1>
          <p class="subtitle">
            Thank you for booking your appointment. Please keep this
            confirmation for your records.
          </p>

          <div class="info-grid">
            <div class="info-item">
              <span class="label">Patient</span>
              <div class="value"><%= patientName %></div>
            </div>
            <div class="info-item">
              <span class="label">Patient Email</span>
              <div class="value"><%= patientEmail %></div>
            </div>
            <div class="info-item">
              <span class="label">Doctor</span>
              <div class="value"><%= doctorName %></div>
            </div>
            <div class="info-item">
              <span class="label">Doctor Email</span>
              <div class="value"><%= doctorEmail %></div>
            </div>
            <div class="info-item">
              <span class="label">Date</span>
              <div class="value"><%= scheduleDate %></div>
            </div>
            <div class="info-item">
              <span class="label">Time</span>
              <div class="value"><%= joiningTime %></div>
            </div>
            <div class="info-item">
              <span class="label">Serial Number</span>
              <div class="value"><%= serialNumber %></div>
            </div>
            <div class="info-item full-width">
              <span class="label">Meeting Link</span>
              <div class="value">
                <a href="<%= meetingLink %>"><%= meetingLink %></a>
              </div>
            </div>
            <div class="info-item">
              <span class="label">Amount Paid</span>
              <div class="value"><%= amount %> BDT</div>
            </div>
            <div class="info-item">
              <span class="label">Payment Method</span>
              <div class="value"><%= paymentMethod %></div>
            </div>
            <div class="info-item">
              <span class="label">Transaction ID</span>
              <div class="value"><%= transactionID %></div>
            </div>
            <div class="info-item">
              <span class="label">Paid At</span>
              <div class="value"><%= paidAt %></div>
            </div>
          </div>

          <div class="note">
            Please arrive 10 minutes early and bring your ID or insurance card.
            If you need to reschedule, contact our front desk at least 24 hours
            in advance.
          </div>
        </div>

        <div class="footer">
          Your appointment confirmation is attached as a PDF.
        </div>
      </div>
    </div>
  </body>
</html>
