# Vercel reads this instead of .gitignore, so the .gitignore entries are
# repeated here. dist/ is intentionally absent: vercel.json points at the
# bundle, and a `builds` array means the platform never runs the build script,
# so `pnpm build` has to run locally before `vercel --prod`.

# Local-only pnpm settings file. It has no `packages:` field, which pnpm 11
# (local) accepts but pnpm 9 (Vercel's build image) rejects with
# "ERROR packages field missing or empty".
pnpm-workspace.yaml

# Only pnpm-lock.yaml should drive the install.
package-lock.json

# Secrets belong in Vercel project environment variables, never in the upload.
.env
.env.*

# Bundled into dist/index.js already; no need to upload the source separately.
src/generated

node_modules
.git
.vercel

# Docs
Project Requirements.md
README.md
